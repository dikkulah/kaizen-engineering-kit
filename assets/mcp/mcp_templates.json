{
  "mcpServers": {
    "serena": {
      "type": "http",
      "url": "http://127.0.0.1:24280/mcp"
    },
    "kaizen-atlassian": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "${ATLASSIAN_MCP_URL}"],
      "env": {
        "JIRA_URL": "https://kaizen.atlassian.net",
        "CONFLUENCE_URL": "https://kaizen.atlassian.net/wiki",
        "JIRA_USERNAME": "${KAIZEN_EMAIL}",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}"
      }
    },
    "kaizen-gitlab": {
      "command": "npx",
      "args": ["-y", "@zereight/mcp-gitlab"],
      "env": {
        "GITLAB_API_URL": "https://gitlab.example.org/api/v4",
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${KAIZEN_GITLAB_PAT}"
      }
    },
    "internal-git-gitlab": {
      "command": "npx",
      "args": ["-y", "@zereight/mcp-gitlab"],
      "env": {
        "GITLAB_API_URL": "https://gitlab.internal.example/api/v4",
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${INTERNAL_GITLAB_PAT}"
      }
    },
    "kaizen-devops": {
      "command": "node",
      "args": ["${KAIZEN_DEVOPS_GATEWAY_JS}"],
      "env": {
        "MCP_SERVER_NAME": "kaizen-devops",
        "WORKSPACE_ROOT": "${WORKSPACE_ROOT}"
      }
    },
    "awsknowledge": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
